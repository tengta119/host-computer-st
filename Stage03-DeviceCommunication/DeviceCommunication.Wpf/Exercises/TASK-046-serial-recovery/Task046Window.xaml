<Window x:Class="DeviceCommunication.Wpf.Exercises.Task046.Task046Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TASK-046 串口超时与恢复" Width="1100" Height="760" MinWidth="960" MinHeight="640"
        Background="#F3F6FA">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="串口超时与恢复" FontSize="25" FontWeight="Bold" Foreground="#172B4D"/>
            <TextBlock Text="115200 · 8数据位 · 无校验 · 1停止位　|　模拟设备继续用 TASK-044 的另一端串口" Margin="0,6,0,12" TextWrapping="Wrap"/>
            <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="本机端口" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="PortComboBox" Width="140" IsEditable="True" Margin="0,0,8,0" VerticalContentAlignment="Center" ToolTip="选择虚拟串口对里给上位机使用的那一端。"/>
                <Button x:Name="RefreshPortsButton" Content="刷新端口" Click="RefreshPortsClick"/>
                <Button x:Name="ConnectButton" Content="连接" Click="ConnectClick"/>
                <Button x:Name="DisconnectButton" Content="断开" Click="DisconnectClick"/>
                <Button x:Name="SendButton" Content="发送请求 55 01" Click="SendClick"/>
            </WrapPanel>
            <TextBlock x:Name="ConnectionStatusText" Text="未连接" FontWeight="Bold" Foreground="#334155" TextWrapping="Wrap"/>
            <TextBlock x:Name="RequestStatusText" Text="尚未等待响应 · 超时上限 3 秒" Margin="0,5,0,0" Foreground="#075985" TextWrapping="Wrap"/>
            <TextBlock x:Name="OperationText" Text="串口与显示已复用，等待、超时和恢复逻辑留给本题实现。" Margin="0,5,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="LatestReadingText" Text="尚未收到读数" FontSize="23" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ReadingCountText" Text="历史条数：0" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="18,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="报警阈值 ℃" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="ThresholdInput" Text="25.5" Width="70" Padding="6,4"/>
                        <Button Content="应用" Click="ApplyThresholdClick" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="AlarmText" Text="暂无温度" Margin="0,7,0,0" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="White" CornerRadius="8" Padding="14" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,10">
                        <TextBlock Text="温度曲线" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ComboBox x:Name="ChartDeviceComboBox" Width="110" SelectedIndex="0" SelectionChanged="ChartDeviceChanged">
                            <ComboBoxItem Content="设备 1" Tag="1"/>
                            <ComboBoxItem Content="设备 2" Tag="2"/>
                        </ComboBox>
                        <TextBlock Text="最新30条" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </WrapPanel>
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Canvas x:Name="ChartCanvas" Background="#F5F8FC" ClipToBounds="True" SizeChanged="ChartSizeChanged">
                            <Polyline x:Name="TemperatureLine" Stroke="#2563EB" StrokeThickness="2.5"/>
                            <Ellipse x:Name="SingleReadingDot" Width="7" Height="7" Fill="#2563EB" Visibility="Collapsed"/>
                        </Canvas>
                        <TextBlock Grid.Row="1" Text="横向：接收顺序　纵向：按当前读数范围显示温度" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="11"/>
                        <TextBlock x:Name="ChartEmptyText" Text="所选设备暂无读数" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#64748B"/>
                    </Grid>
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="接收历史（所有设备）" FontWeight="Bold" Margin="0,0,0,10"/>
                    <DataGrid x:Name="HistoryGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding ReceivedAt, StringFormat=HH:mm:ss.fff}" Width="*"/>
                            <DataGridTextColumn Header="设备" Binding="{Binding DeviceId}" Width="55"/>
                            <DataGridTextColumn Header="原始值" Binding="{Binding RawValue}" Width="65"/>
                            <DataGridTextColumn Header="温度 ℃" Binding="{Binding Temperature, StringFormat=F1}" Width="75"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
        <TextBlock Grid.Row="3" Text="同时只等待一个请求；收到完整读数结束等待，半帧继续保留；超时后仍可重新发送。" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#475569"/>
    </Grid>
</Window>
