<Window x:Class="DeviceCommunication.Wpf.Exercises.Task048.Task048Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TASK-048 串口监控与通信日志" Width="1180" Height="940" MinWidth="1040" MinHeight="840"
        Background="#F3F6FA">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="220"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="串口监控与通信日志" FontSize="25" FontWeight="Bold" Foreground="#172B4D"/>
            <TextBlock Text="115200 · 8数据位 · 无校验 · 1停止位　|　使用 TASK-047 专用模拟端，末字节按前五字节加和取余" Margin="0,6,0,12" TextWrapping="Wrap"/>
            <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="本机端口" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="PortComboBox" Width="140" IsEditable="True" Margin="0,0,8,0" VerticalContentAlignment="Center" ToolTip="选择虚拟串口对里给上位机使用的那一端。"/>
                <Button x:Name="RefreshPortsButton" Content="刷新端口" Click="RefreshPortsClick"/>
                <Button x:Name="ConnectButton" Content="连接" Click="ConnectClick"/>
                <Button x:Name="DisconnectButton" Content="断开" Click="DisconnectClick"/>
                <Button x:Name="SendButton" Content="发送请求 55 01" Click="SendClick"/>
            </WrapPanel>
            <TextBlock x:Name="ConnectionStatusText" Text="未连接" FontWeight="Bold" Foreground="#334155" TextWrapping="Wrap"/>
            <TextBlock x:Name="RequestStatusText" Text="尚未等待响应 · 超时上限 3 秒" Margin="0,5,0,0" Foreground="#075985" TextWrapping="Wrap"/>
            <TextBlock x:Name="OperationText" Text="合法帧进入历史，坏帧丢弃并继续寻找后续有效数据。" Margin="0,5,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="LatestReadingText" Text="尚未收到读数" FontSize="23" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ReadingCountText" Text="历史条数：0" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="18,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="报警阈值 ℃" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="ThresholdInput" Text="25.5" Width="70" Padding="6,4"/>
                        <Button Content="应用" Click="ApplyThresholdClick" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="AlarmText" Text="暂无温度" Margin="0,7,0,0" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="White" CornerRadius="8" Padding="14" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,10">
                        <TextBlock Text="温度曲线" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ComboBox x:Name="ChartDeviceComboBox" Width="110" SelectedIndex="0" SelectionChanged="ChartDeviceChanged">
                            <ComboBoxItem Content="设备 1" Tag="1"/>
                            <ComboBoxItem Content="设备 2" Tag="2"/>
                        </ComboBox>
                        <TextBlock Text="最新30条" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </WrapPanel>
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Canvas x:Name="ChartCanvas" Background="#F5F8FC" ClipToBounds="True" SizeChanged="ChartSizeChanged">
                            <Polyline x:Name="TemperatureLine" Stroke="#2563EB" StrokeThickness="2.5"/>
                            <Ellipse x:Name="SingleReadingDot" Width="7" Height="7" Fill="#2563EB" Visibility="Collapsed"/>
                        </Canvas>
                        <TextBlock Grid.Row="1" Text="横向：接收顺序　纵向：按当前读数范围显示温度" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="11"/>
                        <TextBlock x:Name="ChartEmptyText" Text="所选设备暂无读数" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#64748B"/>
                    </Grid>
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="接收历史（所有设备）" FontWeight="Bold" Margin="0,0,0,10"/>
                    <DataGrid x:Name="HistoryGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding ReceivedAt, StringFormat=HH:mm:ss.fff}" Width="*"/>
                            <DataGridTextColumn Header="设备" Binding="{Binding DeviceId}" Width="55"/>
                            <DataGridTextColumn Header="原始值" Binding="{Binding RawValue}" Width="65"/>
                            <DataGridTextColumn Header="温度 ℃" Binding="{Binding Temperature, StringFormat=F1}" Width="75"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="12" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="清空日志" Click="ClearLogsClick" Margin="8,0,0,0"/>
                    <TextBlock x:Name="LogCountText" DockPanel.Dock="Right" Text="日志条数：0 / 200" VerticalAlignment="Center"/>
                    <TextBlock Text="通信日志" FontWeight="Bold" VerticalAlignment="Center"/>
                </DockPanel>
                <DataGrid x:Name="CommunicationLogGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="电脑时间" Binding="{Binding CreatedAt, StringFormat=HH:mm:ss.fff}" Width="100"/>
                        <DataGridTextColumn Header="连接" Binding="{Binding SessionText}" Width="50"/>
                        <DataGridTextColumn Header="端口" Binding="{Binding PortName}" Width="65"/>
                        <DataGridTextColumn Header="类别" Binding="{Binding Category}" Width="80"/>
                        <DataGridTextColumn Header="字节数" Binding="{Binding ByteCountText}" Width="60"/>
                        <DataGridTemplateColumn Header="原始字节" Width="260">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding BytesHex}" TextTrimming="CharacterEllipsis">
                                        <TextBlock.ToolTip><ToolTip><TextBlock Text="{Binding BytesHex}" TextWrapping="Wrap" MaxWidth="600"/></ToolTip></TextBlock.ToolTip>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="*" MinWidth="200">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="ToolTip">
                                        <Setter.Value><ToolTip><TextBlock Text="{Binding Message}" TextWrapping="Wrap" MaxWidth="600"/></ToolTip></Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
        <TextBlock Grid.Row="4" Text="协议：AA · 设备01/02 · 命令03 · 原始值0至1000 · 前五字节加和除以256的余数；坏帧不算回复。" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#475569"/>
    </Grid>
</Window>
