<Window x:Class="WpfBae.Exercises.Task009.Task009Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TASK-009：设备读数练习" Height="360" Width="560"
        MinHeight="300" MinWidth="360">
    <!-- TODO 1：将标题改为你的设备温度监控场景，调整布局和间距。
         已提供最小 StackPanel 骨架；可以继续用它，也可以尝试 Grid。
         保留下列 x:Name 和 Click 关联，缩小窗口后检查文字是否可读。 -->
    <StackPanel Margin="20">
        <TextBlock Text="设备温度监控" />
        <TextBox x:Name="DeviceIdTextBox" Text="TEMP-001" Margin="0,8,0,12" />
        <Button Content="读取温度" Click="ReadButton_Click"
                HorizontalAlignment="Left" Padding="12,6" />
        <TextBlock Text="读取结果" Margin="0,16,0,8" />
        <TextBlock x:Name="ResultTextBlock" Text="尚未读取" TextWrapping="Wrap" />
        <TextBlock x:Name="StatusTextBlock" Text="请完成 TODO 后尝试读取。" Margin="0,12,0,0" TextWrapping="Wrap" />
    </StackPanel>
</Window>
