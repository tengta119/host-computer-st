<Window x:Class="WpfBae.Exercises.Task035.Task035Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TASK-035：阈值输入与应用绑定" Width="960" Height="960"
        MinWidth="860" MinHeight="920">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="模拟温度监控：阈值输入与应用绑定" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="样例按 24、26.5、25、28 °C 循环；表格保留全部历史。"
                       Margin="0,8,0,12" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button x:Name="StartButton" Content="启动" Padding="12,6" Click="StartButton_Click" />
                <Button x:Name="StopButton" Content="停止" Padding="12,6" Margin="12,0,0,0" Click="StopButton_Click" />
                <Button x:Name="ObserveButton" Content="观察通知（临时）" Padding="12,6" Margin="12,0,12,0" Click="ObserveButton_Click"  Visibility="Collapsed"  />
                <!-- TASK-034已验证的追加命令绑定。 -->
                <Button x:Name="AddButton" Content="添加下一条" Padding="12,6" Command="{Binding AddCommand}"/>
                <!-- TASK-034已验证的清空命令绑定。 -->
                <Button x:Name="ClearButton" Content="清空" Padding="12,6" Command="{Binding ClearCommand}"
                        Margin="12,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock x:Name="SamplingStateText" Text="采集状态：已停止" Margin="0,0,24,0" />
                <TextBlock x:Name="TickCountText" Text="通知次数：0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="报警阈值 (°C)" VerticalAlignment="Center" Margin="0,0,12,0" />
                <!-- TOD 1a（实践1 / DoD 1准备）：Text改为TwoWay绑定ThresholdInputText，UpdateSourceTrigger设为PropertyChanged。 -->
                <TextBox x:Name="ThresholdInput" Text="{Binding ThresholdInputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="90" Padding="6,4" VerticalContentAlignment="Center" />
                <!-- TOD 2b（实践2 / DoD 1）：删除应用按钮Click，改为Command绑定ApplyThresholdCommand。 -->
                <Button x:Name="ApplyThresholdButton" Content="应用阈值" Padding="12,6" Margin="12,0,16,0" Command="{Binding ApplyThresholdCommand}"/>
                <Button x:Name="SaveThresholdButton" Content="保存阈值" Padding="12,6" Margin="0,0,16,0" Click="SaveThresholdButton_Click" />
                <!-- TOD 4a（实践2 / DoD 1/2）：Text绑定CurrentThresholdText，配合后台移除旧直接显示。 -->
                <TextBlock x:Name="CurrentThresholdText" Text="{Binding CurrentThresholdText}" VerticalAlignment="Center" />
            </StackPanel>
            <!-- TOD 1b（实践1 / DoD 1准备）：下面观察文字的Text绑定ThresholdInputText，仅观察输入，不应用。 -->
            <TextBlock x:Name="ThresholdInputObservationText" Text="{Binding ThresholdInputText, Mode=OneWay}" FontSize="12" Margin="0,0,0,6" />
            <!-- TOD 4b（实践2 / DoD 1）：反馈Text绑定ThresholdFeedbackText，移除旧Click后不再给它直接赋Text。 -->
            <TextBlock x:Name="ThresholdFeedbackText" Text="{Binding ThresholdFeedbackText}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBlock x:Name="ConfigStatusText" Text="配置功能待完成。" TextWrapping="Wrap" Margin="0,0,0,6" />
            <TextBlock x:Name="ConfigPathText" Text="配置路径初始化中。" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Button x:Name="ExportHistoryButton" Content="导出历史" Padding="12,6" Click="ExportHistoryButton_Click" />
                <TextBlock Text="停止采集后选择保存位置，导出全部历史。" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
            <TextBlock x:Name="ExportStatusText" Text="本题首步：输入文字进入ViewModel，有效阈值暂不改变。" TextWrapping="Wrap" Margin="0,0,0,6" />
            <TextBlock x:Name="ExportPathText" Text="CSV位置：尚未选择。" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8" />
            <!-- TASK-033已验证的报警文字绑定。 -->
            <TextBlock x:Name="AlarmText" Text="{Binding AlarmText}"  FontSize="18" FontWeight="Bold" Margin="0,0,0,8" />
            <!-- TASK-033已验证的完整历史计数绑定。 -->
            <TextBlock x:Name="ReadingCountText" Text="{Binding ReadingCountText}" FontWeight="Bold" Margin="0,0,0,12" />
        </StackPanel>

        <!-- 布局、表格、绘图与启停沿用原作品，本题新增导出入口。 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="ChartRegion" Grid.Column="0" Margin="0,0,20,0">
                <TextBlock Text="最新最多三条" FontWeight="Bold" Margin="0,0,0,8" />
                <Canvas x:Name="ChartCanvas" Width="560" Height="300"
                        HorizontalAlignment="Left" Background="#F8FAFC">
                    <Rectangle Canvas.Left="100" Canvas.Top="40" Width="360" Height="200"
                               Fill="#EEF2F6" Stroke="#94A3B8" StrokeThickness="1" />
                    <TextBlock Canvas.Left="35" Canvas.Top="30" Text="30 °C" />
                    <TextBlock Canvas.Left="35" Canvas.Top="130" Text="25 °C" />
                    <TextBlock Canvas.Left="35" Canvas.Top="230" Text="20 °C" />
                    <Polyline x:Name="TemperatureLine" Stroke="#2563EB" StrokeThickness="3" />
                    <Ellipse x:Name="SinglePointMarker" Width="8" Height="8"
                             Fill="#2563EB" Visibility="Collapsed" />
                    <TextBlock x:Name="FirstReadingLabel" Canvas.Left="55" Canvas.Top="260"
                               Width="90" TextAlignment="Center" />
                    <TextBlock x:Name="SecondReadingLabel" Canvas.Left="235" Canvas.Top="260"
                               Width="90" TextAlignment="Center" />
                    <TextBlock x:Name="ThirdReadingLabel" Canvas.Left="415" Canvas.Top="260"
                               Width="90" TextAlignment="Center" />
                </Canvas>
            </StackPanel>

            <Grid x:Name="HistoryRegion" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="完整温度历史" FontWeight="Bold" Margin="0,0,0,8" />
                <!-- 此表格连接原温度集合，显示全部历史，保持只读和添加顺序。 -->
                <!-- TASK-033已验证的同集合表格绑定。 -->
                <DataGrid x:Name="HistoryDataGrid" Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          ItemsSource="{Binding Temperatures}"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False" CanUserSortColumns="False">
                    <DataGrid.Columns>
                        <!-- 该 Binding 由教练提供，不计学员自主完成列绑定。 -->
                        <DataGridTextColumn Header="温度 (°C)" Binding="{Binding Path=., Mode=OneWay}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="2" Margin="0,12,0,0" TextWrapping="Wrap"
                   Text="点击启动后约每秒追加一条温度，停止后保留历史；停止时可以清空，清空后下一条从 24 °C 开始。表格显示完整历史，折线显示最新最多三条。" />
    </Grid>
</Window>
