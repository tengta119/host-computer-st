<Window x:Class="WpfBae.Exercises.Task017.Task017Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:history="clr-namespace:WpfBae.Exercises.Task017"
        Title="TASK-017：用 ControlTemplate 定义按钮外观" Height="460" Width="560"
        MinHeight="460" MinWidth="360">
    <Window.Resources>
        <!-- ActionButtonStyle 是沿用的自定义资源键；Style/Setter 是 WPF 类型。 -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="24,10" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <!-- Template 是 Button 的属性；Setter.Value 内放的是这个属性的值。 -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Border 是 WPF 容器，包住下方内容显示控件。
                             （首个动作 / DoD 1）：只把 CornerRadius 的 0 改成 12。
                             关闭旧程序后运行，观察读取和清空两个按钮的角是否一起变圆。 -->
                        <Border x:Name="ButtonBorder" CornerRadius="12"
                                Background="#E8F0FE" BorderBrush="#4267A9" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <!-- 实践 2 / DoD 1）：理解 ContentPresenter 后，显式添加
                                 Content 的 TemplateBinding，让它读取当前 Button.Content。
                                 当前依靠 ContentPresenter 的默认内容连接，保证首步文字可读；
                                 不把“读取温度”或“清空历史”写死在共享模板里。 -->
                            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <!-- （实践 2 / DoD 1）：理解 TemplateBinding 后，把上方 Border
                             固定 Padding 改为读取当前 Button.Padding，使共同 Style 的留白生效。
                             先理解属性来源，再修改；当前固定值只是可运行占位。 -->
                            
                        <ControlTemplate.Triggers>
                            <!-- （实践 3 / DoD 3）：理解 Trigger 与 Opacity 后，
                                 在 Button.IsEnabled 为 False 时降低外观 Opacity；启用时恢复。
                                 只控制外观，不在这里设置 IsEnabled 或执行清空命令。 -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4">
                                    
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <StackPanel Margin="20">
        <TextBlock Text="设备 ID" />
        <TextBox x:Name="DeviceIdTextBox" Text="{Binding DeviceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,12" />
        <Button x:Name="ReadButton" Style="{StaticResource ActionButtonStyle}" Content="读取温度" Command="{Binding ReadCommand, Mode=OneWay}" />
        <history:ReadingHistoryControl x:Name="HistoryControl" Margin="0,16,0,0" />
        <TextBlock x:Name="StatusTextBlock" Text="{Binding StatusText, Mode=OneWay}" Margin="0,12,0,0" TextWrapping="Wrap" />
    </StackPanel>
</Window>
