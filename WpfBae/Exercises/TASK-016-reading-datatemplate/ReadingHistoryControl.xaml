<UserControl x:Class="WpfBae.Exercises.Task016.ReadingHistoryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="读取历史" />
        <!-- ItemsSource 从窗口的 ViewModel 取得原集合；ItemTemplate 描述每条读数的显示。 -->
        <ListBox x:Name="HistoryListBox" ItemsSource="{Binding Readings, Mode=OneWay}" Height="170">
            <!-- ListBox.ItemTemplate 是给 ListBox 的 ItemTemplate 属性赋值的 XAML 写法。 -->
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!-- DataTemplate 是 WPF 类型；每行以对应 Reading 为数据源。
                         Horizontal 表示内部文字从左到右排列。 -->
                    <StackPanel Orientation="Horizontal">
                        <!-- TODO 1（首个动作）：把下方固定文字改为读取 DeviceId 的 OneWay Binding。
                             读取 TEMP-001，再改输入为 TEMP-002 并读取；两行应分别保留自己的 ID。
                             不在这里绑定 Readings，也不把数据源改回窗口 ViewModel。 -->
                        <TextBlock Text="{Binding DeviceId, Mode=OneWay}" Margin="0,0,12,0"/>
                        <!-- TODO 2：在这里再添加两个 TextBlock，通过 OneWay Binding 分别显示
                             当前 Reading 的 Value、Unit；不拼接整行，不修改 Reading.ToString()。 -->
                        <!-- TODO 3：为文字加必要 Margin，保证 ID、数值、单位分开且可读。
                             两个值是左右/上下；四个值是左/上/右/下，例如 0,0,12,0 留右侧空隙。 -->
                        <TextBlock Text="{Binding Value, Mode=OneWay}" Margin="0, 0 12 0"></TextBlock>
                        <TextBlock Text="{Binding Unit, Mode=OneWay}" Margin="0, 0 12 0"></TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <!-- 内部控件先独立加载，沿用 TASK-015 的 DynamicResource 延后查找窗口样式。 -->
        <Button x:Name="ClearButton" Content="清空历史" Command="{Binding ClearCommand, Mode=OneWay}" Style="{DynamicResource ActionButtonStyle}" />
        <!-- TODO 4（字段显示完成后）：实际验证连续读取、换 ID、两种空白输入保留历史、
             清空后禁用和再次读取恢复，并确认两按钮仍使用共同样式。 -->
    </StackPanel>
</UserControl>
