<Window x:Class="WpfBae.Exercises.Task016.Task016Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:history="clr-namespace:WpfBae.Exercises.Task016"
        Title="TASK-016：用 DataTemplate 展示读取历史" Height="460" Width="560"
        MinHeight="460" MinWidth="360">
    <!-- 沿用 TASK-015 已完成的样式；本次核心练习在历史控件的行模板内。 -->
    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="24,10" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="20">
        <TextBlock Text="设备 ID" />
        <TextBox x:Name="DeviceIdTextBox" Text="{Binding DeviceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,12" />
        <Button x:Name="ReadButton" Style="{StaticResource ActionButtonStyle}" Content="读取温度" Command="{Binding ReadCommand, Mode=OneWay}" />
        <history:ReadingHistoryControl x:Name="HistoryControl" Margin="0,16,0,0" />
        <TextBlock x:Name="StatusTextBlock" Text="{Binding StatusText, Mode=OneWay}" Margin="0,12,0,0" TextWrapping="Wrap" />
    </StackPanel>
</Window>
