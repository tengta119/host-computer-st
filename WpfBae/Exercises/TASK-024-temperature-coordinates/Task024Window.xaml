<Window x:Class="WpfBae.Exercises.Task024.Task024Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TASK-024：温度换算为折线坐标" Width="640" Height="620"
        MinWidth="640" MinHeight="620">
    <StackPanel Margin="24">
        <TextBlock Text="三次模拟温度读取" FontSize="20" FontWeight="Bold" />
        <TextBlock Text="固定范围：20～30 °C；从左到右表示第 1、2、3 次读取。"
                   Margin="0,8,0,12" />
        <!-- 复用 TASK-018 绘图区和标签位置。ChartCanvas / TemperatureLine 是自定义名字。
             Canvas / Rectangle / Polyline / TextBlock 是 WPF 提供的界面对象。
             Canvas 左上角是 (0,0)，x 向右增加，y 向下增加。 -->
        <Canvas x:Name="ChartCanvas" Width="560" Height="300"
                HorizontalAlignment="Left" Background="#F8FAFC">
            <Rectangle Canvas.Left="100" Canvas.Top="40" Width="360" Height="200"
                       Fill="#EEF2F6" Stroke="#94A3B8" StrokeThickness="1" />
            <TextBlock Canvas.Left="35" Canvas.Top="30" Text="30 °C" />
            <TextBlock Canvas.Left="35" Canvas.Top="130" Text="25 °C" />
            <TextBlock Canvas.Left="35" Canvas.Top="230" Text="20 °C" />
            <!-- Points 由后台绘图循环提供；转换完成前，蓝线还不能表示温度。 -->
            <Polyline x:Name="TemperatureLine" Stroke="#2563EB" StrokeThickness="3" />
            <TextBlock x:Name="FirstReadingLabel" Canvas.Left="55" Canvas.Top="260"
                       Width="90" TextAlignment="Center" />
            <TextBlock x:Name="SecondReadingLabel" Canvas.Left="235" Canvas.Top="260"
                       Width="90" TextAlignment="Center" />
            <TextBlock x:Name="ThirdReadingLabel" Canvas.Left="415" Canvas.Top="260"
                       Width="90" TextAlignment="Center" />
        </Canvas>
        <!-- 教练新增的输出位置：只显示转换方法实际返回什么，不替学员完成计算。 -->
        <TextBlock Text="当前方法返回值（完成最终换算后才是 y）" FontWeight="Bold" Margin="0,12,0,6" />
        <TextBlock x:Name="ConversionResults" TextWrapping="Wrap" />
        <TextBlock x:Name="ExerciseHint" Margin="0,12,0,0" TextWrapping="Wrap"
                   Text="先做 TODO 1：返回比 20 °C 高出的度数。此时观察数值输出，蓝线位置还不是最终结果。完成 TODO 2 后再核对折线。" />
    </StackPanel>
</Window>
