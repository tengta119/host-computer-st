<Window x:Class="WpfBae.Exercises.Task011.Task011Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TASK-011：温度读取历史" Height="460" Width="560"
        MinHeight="460" MinWidth="360">
    <!-- StackPanel 沿用前两次练习：里面的控件依次从上到下排列。 -->
    <StackPanel Margin="20">
        <TextBlock Text="设备 ID" />
        <TextBox x:Name="DeviceIdTextBox" Text="TEMP-001" Margin="0,8,0,12" />
        <Button Content="读取温度" Click="ReadButton_Click" HorizontalAlignment="Left" Padding="12,6" />
        <TextBlock Text="读取历史" Margin="0,16,0,8" />
        <!-- ListBox 是 WPF 的列表控件；Height 给列表留出显示区域。
             ItemsSource 是 WPF 属性，表示列表的数据从哪个集合取得。
             Binding Readings：从 DataContext 对象读取 Readings 属性。
             连接由骨架提供；本次核心是通过集合 Add/Clear 让列表自动更新。 -->
        <ListBox x:Name="HistoryListBox" ItemsSource="{Binding Readings, Mode=OneWay}" Height="170" />
        <Button Content="清空历史" Click="ClearButton_Click" HorizontalAlignment="Left" Padding="12,6" Margin="0,12,0,0" />
        <!-- 状态提示沿用 TASK-009 的 Text 赋值，本次不新增属性通知骨架。 -->
        <TextBlock x:Name="StatusTextBlock" Text="历史为空。先完成 TODO 1，再读取温度。" Margin="0,12,0,0" TextWrapping="Wrap" />
    </StackPanel>
</Window>
