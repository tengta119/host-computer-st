<Window x:Class="WpfBae.Exercises.Task013.Task013Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TASK-013：读取逻辑与 ViewModel" Height="460" Width="560"
        MinHeight="460" MinWidth="360">
    <!-- 布局沿用 TASK-012；本任务的输入和两个按钮都连接同一 DataContext。 -->
    <StackPanel Margin="20">
        <TextBlock Text="设备 ID" />
        <!-- TwoWay：对象属性可显示到输入框，编辑输入框也会写回对象属性。
             UpdateSourceTrigger 是 WPF Binding 的设置；PropertyChanged 表示文字改变时写回，
             与自定义 OnPropertyChanged 方法不是同一个东西。 -->
        <TextBox x:Name="DeviceIdTextBox" Text="{Binding DeviceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,12" />
        <!-- ReadCommand 是 ViewModel 自定义公开属性，返回读取命令对象。没有 Click。 -->
        <Button x:Name="ReadButton" Content="读取温度" Command="{Binding ReadCommand, Mode=OneWay}" HorizontalAlignment="Left" Padding="12,6" />
        <TextBlock Text="读取历史" Margin="0,16,0,8" />
        <ListBox x:Name="HistoryListBox" ItemsSource="{Binding Readings, Mode=OneWay}" Height="170" />
        <Button x:Name="ClearButton" Content="清空历史" Command="{Binding ClearCommand, Mode=OneWay}" HorizontalAlignment="Left" Padding="12,6" Margin="0,12,0,0" />
        <TextBlock x:Name="StatusTextBlock" Text="{Binding StatusText, Mode=OneWay}" Margin="0,12,0,0" TextWrapping="Wrap" />
    </StackPanel>
</Window>
