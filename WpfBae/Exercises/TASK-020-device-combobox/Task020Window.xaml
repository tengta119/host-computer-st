<Window x:Class="WpfBae.Exercises.Task020.Task020Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TASK-020：选择设备并读取温度" Height="520" Width="640"
        MinHeight="520" MinWidth="420">
    <StackPanel Margin="20">
        <TextBlock Text="选择设备" />
        <!-- ComboBox 是 WPF 下拉框；DeviceComboBox 是教练给这个控件起的名字。
             后台将两个字符串选项交给它的 ItemsSource，展开后即可选择。
             IsEditable=False：可以选择已有项，不能自由输入新设备 ID。
             TODO 1（首个动作）：只把 Width 从 200 改为 260，运行观察下拉框变宽。
             TODO 2：读完讲解后，为 SelectedItem 添加连接原 DeviceId 的双向绑定。
             当前故意不设置初始选中项；完成 TODO 2 后，默认 TEMP-001 来自原数据对象。
             连接前选择 TEMP-002 不会写回数据对象，读取仍使用原 DeviceId。 -->
        <ComboBox x:Name="DeviceComboBox" Width="260"
                  HorizontalAlignment="Left" IsEditable="False"
                  SelectedItem="{Binding DeviceId}"
                  Margin="0,8,0,12" />
        <Button x:Name="ReadButton" Content="读取温度"
                Command="{Binding ReadCommand, Mode=OneWay}"
                HorizontalAlignment="Left" Padding="12,6" />
        <TextBlock Text="读取历史" Margin="0,16,0,8" />

        <!-- 复用 TASK-019 已完成的表格连接：整张表取原 Readings，三列取各行 Reading。
             只读限制不影响原读取命令 Add 和清空命令 Clear。 -->
        <DataGrid x:Name="HistoryDataGrid" Height="210"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  ItemsSource="{Binding Readings, Mode=OneWay}"
                  CanUserAddRows="False" CanUserDeleteRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="设备 ID" Binding="{Binding DeviceId}" Width="*" />
                <DataGridTextColumn Header="温度" Binding="{Binding Value}" Width="*" />
                <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <Button x:Name="ClearButton" Content="清空历史"
                Command="{Binding ClearCommand, Mode=OneWay}"
                HorizontalAlignment="Left" Padding="12,6" Margin="0,12,0,0" />
        <TextBlock x:Name="StatusTextBlock" Text="{Binding StatusText, Mode=OneWay}"
                   Margin="0,12,0,0" TextWrapping="Wrap" />
    </StackPanel>
</Window>
