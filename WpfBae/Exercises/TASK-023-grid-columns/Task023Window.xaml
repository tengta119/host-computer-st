<Window x:Class="WpfBae.Exercises.Task023.Task023Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TASK-023：用 Grid 列布局组织设备监控界面" Height="640" Width="900"
        MinHeight="420" MinWidth="760">
    <!-- Grid 是 WPF 的布局容器；LayoutGrid 是教练给这个主容器起的名字。
         它直接放在 Window 中，取得窗口内容区。两列的数字宽度是练习占位。 -->
    <Grid x:Name="LayoutGrid" Margin="20">
        <Grid.ColumnDefinitions>
            <!-- TODO 1（首个动作）：只把左列 Width 从 320 改为 360，
                 以相同窗口尺寸重新运行，观察右侧“读取历史”的起点右移。
                 TODO 2：观察后，按任务卡说明安排左列 Auto、右列剩余宽度。 -->
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- OperationsRegion 是整块操作区的自定义名字。
             TODO 2：核对整块操作区在主 Grid 的第 0 列、历史区在第 1 列。
             骨架先给出不重叠的位置，列编号从 0 开始。 -->
        <StackPanel x:Name="OperationsRegion" Grid.Column="0" Margin="0,0,20,0">
            <TextBlock Text="选择设备" />
            <ComboBox x:Name="DeviceComboBox" Width="260"
                      HorizontalAlignment="Left" IsEditable="False"
                      SelectedItem="{Binding DeviceId}"
                      Margin="0,8,0,12" />
            <Button x:Name="ReadButton" Content="读取温度"
                    Command="{Binding ReadCommand, Mode=OneWay}"
                    HorizontalAlignment="Left" Padding="12,6" />
            <Button x:Name="ClearButton" Content="清空历史"
                    Command="{Binding ClearCommand, Mode=OneWay}"
                    HorizontalAlignment="Left" Padding="12,6" Margin="0,12,0,0" />
            <!-- 固定提示文字的宽度是为了在左栏内换行；不限制右表格。
                 Margin 四个数依次是左、上、右、下的外部空隙。 -->
            <TextBlock x:Name="StatusTextBlock" Text="{Binding StatusText, Mode=OneWay}"
                       Width="260" HorizontalAlignment="Left"
                       Margin="0,12,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 主 Grid 给 HistoryRegion 分配右列；这个小 Grid 再给标题/表格分上下行。
             内部 Auto / * 两行由教练沿用原布局提供，不是本次待实现核心。 -->
        <Grid x:Name="HistoryRegion" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="读取历史" Margin="0,0,0,8" />
            <!-- TODO 3：完成主 Grid 列分配后，移除表格固定 Width="300"、
                 Height="210"，让它使用右侧余下空间。保留原绑定和只读设置。
                 实际拉宽、拉高、恢复，并核对最小 760×420 时内容可读。 -->
            <DataGrid x:Name="HistoryDataGrid" Grid.Row="1"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      ItemsSource="{Binding Readings, Mode=OneWay}"
                      CanUserAddRows="False" CanUserDeleteRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="设备 ID" Binding="{Binding DeviceId}" Width="*" />
                    <DataGridTextColumn Header="温度" Binding="{Binding Value}" Width="*" />
                    <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>
