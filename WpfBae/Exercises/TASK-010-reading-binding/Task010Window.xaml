<Window x:Class="WpfBae.Exercises.Task010.Task010Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TASK-010：温度读数绑定练习" Height="360" Width="560"
        MinHeight="300" MinWidth="360">
    <!-- 沿用 TASK-009 的纵向排列，本次只练习结果与状态的 Binding。 -->
    <StackPanel Margin="20">
        <TextBlock Text="设备 ID" />
        <TextBox x:Name="DeviceIdTextBox" Text="TEMP-001" Margin="0,8,0,12" />
        <Button Content="读取温度" Click="ReadButton_Click" HorizontalAlignment="Left" Padding="12,6" />
        <TextBlock Text="读取结果" Margin="0,16,0,8" />
        <!-- TODO 2a：把下面的静态 Text 改为绑定到 ResultText，使用 Mode=OneWay。
             示例语法见任务卡；属性名必须与 ReadingDisplayState 中的属性一致。 -->
        <TextBlock x:Name="ResultTextBlock" Text="{Binding ResultText, Mode=OneWay}" TextWrapping="Wrap" />
        <!-- TODO 2b：仿照结果控件，把下面的 Text 绑定到 StatusText。 -->
        <TextBlock x:Name="StatusTextBlock" Text="{Binding StatusText, Mode=OneWay}" Margin="0,12,0,0" TextWrapping="Wrap" />
    </StackPanel>
</Window>
