<Window x:Class="WpfBae.Exercises.Task025.Task025Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TASK-025：追加温度并刷新折线" Width="640" Height="620"
        MinWidth="640" MinHeight="620">
    <StackPanel Margin="24">
        <TextBlock Text="按钮驱动的温度折线" FontSize="20" FontWeight="Bold" />
        <TextBlock Text="样例按 24、26.5、25、28 °C 循环；图中只显示最新三条。"
                   Margin="0,8,0,12" />
        <!-- Click 是 WPF 按钮事件；右侧是本窗口后台的普通方法名。 -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="AddButton" Content="添加下一条" Padding="12,6"
                    Click="AddButton_Click" />
            <Button x:Name="ClearButton" Content="清空" Padding="12,6"
                    Margin="12,0,0,0" Click="ClearButton_Click" />
        </StackPanel>
        <TextBlock x:Name="ReadingCountText" Text="完整历史条数：0"
                   FontWeight="Bold" Margin="0,0,0,12" />
        <!-- 复用 TASK-024 固定绘图区；三个 x 槽位保持 100 / 280 / 460。 -->
        <Canvas x:Name="ChartCanvas" Width="560" Height="300"
                HorizontalAlignment="Left" Background="#F8FAFC">
            <Rectangle Canvas.Left="100" Canvas.Top="40" Width="360" Height="200"
                       Fill="#EEF2F6" Stroke="#94A3B8" StrokeThickness="1" />
            <TextBlock Canvas.Left="35" Canvas.Top="30" Text="30 °C" />
            <TextBlock Canvas.Left="35" Canvas.Top="130" Text="25 °C" />
            <TextBlock Canvas.Left="35" Canvas.Top="230" Text="20 °C" />
            <Polyline x:Name="TemperatureLine" Stroke="#2563EB" StrokeThickness="3" />
            <!-- 一个坐标不能形成线段，骨架用圆点显示单条读数。 -->
            <Ellipse x:Name="SinglePointMarker" Width="8" Height="8" Fill="#2563EB" Visibility="Collapsed" />
            <TextBlock x:Name="FirstReadingLabel" Canvas.Left="55" Canvas.Top="260"
                       Width="90" TextAlignment="Center" />
            <TextBlock x:Name="SecondReadingLabel" Canvas.Left="235" Canvas.Top="260"
                       Width="90" TextAlignment="Center" />
            <TextBlock x:Name="ThirdReadingLabel" Canvas.Left="415" Canvas.Top="260"
                       Width="90" TextAlignment="Center" />
        </Canvas>
        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                   Text="先做 TODO 1：接通集合通知并更新条数。追加两次再清空，观察 0→1→2→0。此时绘图 TODO 尚未完成，图为空。" />
    </StackPanel>
</Window>
