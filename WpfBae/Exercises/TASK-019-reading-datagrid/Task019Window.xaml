<Window x:Class="WpfBae.Exercises.Task019.Task019Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TASK-019：设备读数表格" Height="520" Width="640"
        MinHeight="520" MinWidth="420">
    <StackPanel Margin="20">
        <TextBlock Text="设备 ID" />
        <!-- 输入和命令复用 TASK-013 的连接，本任务不重新实现读取/清空。 -->
        <TextBox x:Name="DeviceIdTextBox"
                 Text="{Binding DeviceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,8,0,12" />
        <Button x:Name="ReadButton" Content="读取温度"
                Command="{Binding ReadCommand, Mode=OneWay}"
                HorizontalAlignment="Left" Padding="12,6" />
        <TextBlock Text="读取历史" Margin="0,16,0,8" />

        <!-- DataGrid 是 WPF 表格；HistoryDataGrid 是这张表格的自定义名字。
             AutoGenerateColumns=False：只使用下面列出的列，不另外自动生成。
             IsReadOnly=True：表格内不能修改读数；不影响读取命令向集合 Add。
             CanUserAddRows/CanUserDeleteRows=False：不从表格直接新增或删除记录。
             这些限制由骨架提供，先理解效果，再完成数据连接。
             TODO 2：讲解后，在 DataGrid 开始标签添加 ItemsSource，连接原 Readings 集合。
             当前尚未连接，所以点读取会更新集合和提示，但表格仍为空。 -->
        <DataGrid x:Name="HistoryDataGrid" Height="210"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  ItemsSource="{Binding Readings, Mode=OneWay}"
                  CanUserAddRows="False" CanUserDeleteRows="False">
            <DataGrid.Columns>
                <!-- TODO 1（首个动作）：只将第一列 Header 改为“设备 ID”，运行观察表头。
                     TODO 3a：随后为这列添加 Binding，读取每一行 Reading 的 DeviceId。 -->
                <DataGridTextColumn Header="设备 ID" Binding="{Binding DeviceId}" Width="*" />
                <!-- TODO 3b：为温度列添加 Binding，读取每一行 Reading 的 Value。 -->
                <DataGridTextColumn Header="温度" Binding="{Binding Value}" Width="*" />
                <!-- TODO 3c：为单位列添加 Binding，读取每一行 Reading 的 Unit。 -->
                <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <Button x:Name="ClearButton" Content="清空历史"
                Command="{Binding ClearCommand, Mode=OneWay}"
                HorizontalAlignment="Left" Padding="12,6" Margin="0,12,0,0" />
        <TextBlock x:Name="StatusTextBlock" Text="{Binding StatusText, Mode=OneWay}"
                   Margin="0,12,0,0" TextWrapping="Wrap" />
    </StackPanel>
</Window>
