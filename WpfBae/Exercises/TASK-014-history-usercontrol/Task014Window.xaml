<Window x:Class="WpfBae.Exercises.Task014.Task014Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:history="clr-namespace:WpfBae.Exercises.Task014"
        Title="TASK-014：用 UserControl 封装读取历史" Height="460" Width="560"
        MinHeight="460" MinWidth="360">
    <!-- 输入、读取和提示复用 TASK-013 的绑定；历史区域交给自定义控件。 -->
    <StackPanel Margin="20">
        <TextBlock Text="设备 ID" />
        <TextBox x:Name="DeviceIdTextBox" Text="{Binding DeviceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,12" />
        <Button x:Name="ReadButton" Content="读取温度" Command="{Binding ReadCommand, Mode=OneWay}" HorizontalAlignment="Left" Padding="12,6" />
        <!-- history 是上面声明的自定义前缀，指向控件所在的 C# 命名空间。
             此标签让 WPF 创建一个 ReadingHistoryControl 实例，放在窗口内部。
             不单独设置 DataContext，让它继承窗口使用的对象。 -->
        <history:ReadingHistoryControl x:Name="HistoryControl" Margin="0,16,0,0" />
        <TextBlock x:Name="StatusTextBlock" Text="{Binding StatusText, Mode=OneWay}" Margin="0,12,0,0" TextWrapping="Wrap" />
    </StackPanel>
</Window>
