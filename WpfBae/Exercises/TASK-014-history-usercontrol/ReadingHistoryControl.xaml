<UserControl x:Class="WpfBae.Exercises.Task014.ReadingHistoryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- StackPanel 是 WPF 提供的布局控件，默认把内部控件从上到下排列。
         这里只准备容器，三个界面元素和两项绑定留给你实现。 -->
    <StackPanel>
         <!-- TODO 1（首个动作）：在这里添加 TextBlock，Text 为“读取历史”。
             运行任务窗口，确认标题出现在“读取温度”按钮与状态提示之间。 -->
         <TextBlock Text="读取历史" ></TextBlock>         
        <!-- TODO 2：在标题下添加 ListBox，命名 HistoryListBox，Height 为 170。
             ItemsSource 用 OneWay Binding 连接 Readings；复用 TASK-013 的写法。
             列表从继承的 DataContext 取得原集合，不另建历史数据。 -->
         <ListBox ItemsSource="{Binding Readings, Mode=OneWay}" Height="170"></ListBox>
        <!-- TODO 3：在列表下添加 Button，命名 ClearButton，Content 为“清空历史”。
             Command 用 OneWay Binding 连接 ClearCommand；复用 TASK-013 的写法。
             可沿用 HorizontalAlignment="Left"、Padding="12,6"、Margin="0,12,0,0"。
             清空动作由原命令完成，这里不添加业务 Click。 -->
         <Button x:Name="ClearButton" Content="清空历史" Command="{Binding ClearCommand, Mode=OneWay}" HorizontalAlignment="Left" Padding="12,6" Margin="0,12,0,0" />
    </StackPanel>
</UserControl>
