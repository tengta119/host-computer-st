<Window x:Class="WpfBae.Exercises.Task018.Task018Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TASK-018：模拟温度折线" Width="640" Height="510"
        MinWidth="640" MinHeight="510">
    <StackPanel Margin="24">
        <TextBlock Text="三次模拟温度读取" FontSize="20" FontWeight="Bold" />
        <TextBlock Text="固定范围：20～30 °C；从左到右表示第 1、2、3 次读取。"
                   Margin="0,8,0,12" />
        <!-- ChartCanvas 是教练起的名字；Canvas 是 WPF 提供的容器。
             左上角为 (0,0)，x 向右增加，y 向下增加。
             灰色绘图区：x=100～460，y=40～240；三个 x 为 100、280、460。 -->
        <Canvas x:Name="ChartCanvas" Width="560" Height="300" HorizontalAlignment="Left" Background="#F8FAFC">
            <!-- Canvas.Left/Top 指定这个矩形左上角距离 Canvas 左边/上边的位置。
                 Rectangle 是 WPF 矩形，这里只画背景与边框，不是温度数据。 -->
            <Rectangle Canvas.Left="100" Canvas.Top="40" Width="360" Height="200" Fill="#EEF2F6" Stroke="#94A3B8" StrokeThickness="1" />
            <TextBlock Canvas.Left="35" Canvas.Top="30" Text="30 °C" />
            <TextBlock Canvas.Left="35" Canvas.Top="130" Text="25 °C" />
            <TextBlock Canvas.Left="35" Canvas.Top="230" Text="20 °C" />
            <!-- TemperatureLine 是教练起的名字；Polyline 是 WPF 折线。
                 Stroke 是线的颜色，StrokeThickness 是线宽。
                 坐标由后台设置；不对整条线设置 Canvas.Left/Top，避免额外偏移。 -->
            <Polyline x:Name="TemperatureLine" Stroke="#2563EB" StrokeThickness="3" />
            <!-- 下方标签由后台填入原始温度；位置固定在对应 x 下方。
                 现在标签显示样例数据，但占位线尚未表示这些温度。 -->
            <TextBlock x:Name="FirstReadingLabel" Canvas.Left="55" Canvas.Top="260" Width="90" TextAlignment="Center" />
            <TextBlock x:Name="SecondReadingLabel" Canvas.Left="235" Canvas.Top="260" Width="90" TextAlignment="Center" />
            <TextBlock x:Name="ThirdReadingLabel" Canvas.Left="415" Canvas.Top="260" Width="90" TextAlignment="Center" />
        </Canvas>
        <TextBlock x:Name="ExerciseHint" Margin="0,12,0,0" TextWrapping="Wrap"
                   Text="当前蓝线是占位线，尚未由温度计算。先做 TODO 1：只改中间点的 y。" />
    </StackPanel>
</Window>
