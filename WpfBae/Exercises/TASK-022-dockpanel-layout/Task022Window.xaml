<Window x:Class="WpfBae.Exercises.Task022.Task022Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TASK-022：用 DockPanel 组织设备读取窗口" Height="640" Width="640"
        MinHeight="600" MinWidth="420">
    <!-- LayoutDockPanel 是教练给主容器起的名字；DockPanel 是 WPF 提供的容器。
         它直接放在 Window 中，取得窗口内容区的有限空间。
         TODO 3：理解最后区域填满的规则后，把 HistoryRegion 整块移到最后，
         再启用 LastChildFill。当前 False 是方便逐步观察的占位。 -->
    <DockPanel x:Name="LayoutDockPanel" Margin="20" LastChildFill="True">
        <!-- TODO 1（首个动作）：只把 SelectionRegion 的 DockPanel.Dock
             从 Bottom 改为 Top；其他设置先保留，重新运行比较位置。
             Dock 设置这整块选择区靠主容器的哪条边。 -->
        <StackPanel x:Name="SelectionRegion" DockPanel.Dock="Top">
            <TextBlock Text="选择设备" />
            <ComboBox x:Name="DeviceComboBox" Width="260"
                      HorizontalAlignment="Left" IsEditable="False"
                      SelectedItem="{Binding DeviceId}"
                      Margin="0,8,0,12" />
            <Button x:Name="ReadButton" Content="读取温度"
                    Command="{Binding ReadCommand, Mode=OneWay}"
                    HorizontalAlignment="Left" Padding="12,6" />
        </StackPanel>
        
        <!-- TODO 2：按任务卡讲解，让清空按钮和提示所在整块区域靠底边。 -->
        <StackPanel x:Name="ActionsRegion" DockPanel.Dock="Bottom">
            <Button x:Name="ClearButton" Content="清空历史"
                    Command="{Binding ClearCommand, Mode=OneWay}"
                    HorizontalAlignment="Left" Padding="12,6" Margin="0,12,0,0" />
            <TextBlock x:Name="StatusTextBlock" Text="{Binding StatusText, Mode=OneWay}"
                       Margin="0,12,0,0" TextWrapping="Wrap" />
        </StackPanel>
        
        <Grid x:Name="HistoryRegion" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="读取历史" Margin="0,0,0,8" />
            <!-- TODO 4：完成区域安排后，移除表格固定 Height="210"，
                 让表格使用历史区得到的其余高度。保留原 Binding 和只读设置。 -->
            <DataGrid x:Name="HistoryDataGrid" Grid.Row="1" 
                      AutoGenerateColumns="False" IsReadOnly="True"
                      ItemsSource="{Binding Readings, Mode=OneWay}"
                      CanUserAddRows="False" CanUserDeleteRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="设备 ID" Binding="{Binding DeviceId}" Width="*" />
                    <DataGridTextColumn Header="温度" Binding="{Binding Value}" Width="*" />
                    <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
